@page
@model OpenSEE.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">An error occurred while processing your request.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>
    The details about this error have been logged on the server.
    If this error keeps happening, please contact your system administrator.
</p>
<p>
    To return to the homepage, <a asp-route="System">click here</a>.
</p>
