{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "*": [ "types/*" ] },
    "jsx": "react",
    "lib": [ "dom", "es5", "scripthost", "es2019", "es6", "es2020" ],
    "noEmitOnError": true,
    "downlevelIteration": true,
    "noImplicitAny": false,
    "removeComments": true,
    "sourceMap": true,
    "target": "es5",
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "typeRoots": [ "node_modules/@types" ],
  },
  "include": [ "wwwroot/Scripts/TSX", "wwwroot/Scripts/TS/*" ],
  "exclude": [
    "node_modules",
    "lib"
  ]
}